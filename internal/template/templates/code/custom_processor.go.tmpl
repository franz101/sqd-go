// splitJSONLChunks splits data into line-aligned chunks (never splitting a
// JSONL line across a boundary), each capped at maxParseChunkLines lines and
// targeting workers chunks overall. A page denser than
// workers*maxParseChunkLines lines yields more than workers chunks;
// parseBatchForInsertsParallel bounds actual concurrency to workers via a
// semaphore, so pool sizing only needs headroom for workers chunks in flight
// at once, not len(chunks). Pages too small to bother parallelizing (or
// workers<=1) come back as a single chunk.
func splitJSONLChunks(data []byte, workers int) [][]byte {
	if workers <= 1 || len(data) == 0 {
		return [][]byte{data}
	}
	totalLines := bytes.Count(data, []byte("\n"))
	if totalLines < minParseParallelLines {
		return [][]byte{data}
	}
	// Ceiling division: keeps len(chunks) <= workers in the common case (a
	// floor division leaves a remainder chunk, pushing the count to
	// workers+1 and forcing a pool miss — a full fresh ProtoRingBuffer
	// allocation, defaultRingBufferSize ProtoEventBlocks — for one small
	// chunk). Only a page denser than workers*maxParseChunkLines lines still
	// exceeds workers chunks, which getPooledBatch/getPooledRing's
	// allocate-on-miss fallback handles correctly, just not for free.
	linesPerChunk := (totalLines + workers - 1) / workers
	if linesPerChunk < 1 {
		linesPerChunk = 1
	}
	if linesPerChunk > maxParseChunkLines {
		linesPerChunk = maxParseChunkLines
	}
	chunks := make([][]byte, 0, totalLines/linesPerChunk+1)
	start := 0
	count := 0
	for i := 0; i < len(data); i++ {
		if data[i] == '\n' {
			count++
			if count == linesPerChunk {
				chunks = append(chunks, data[start:i+1])
				start = i + 1
				count = 0
			}
		}
	}
	if start < len(data) {
		chunks = append(chunks, data[start:])
	}
	return chunks
}

