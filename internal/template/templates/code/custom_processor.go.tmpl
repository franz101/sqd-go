		body = body[2:]
	}
	if len(body) != 2*common.HashLength {
		return common.HexToHash(s)
	}
	var h common.Hash
	if _, err := hex.Decode(h[:], unsafe.Slice(unsafe.StringData(body), len(body))); err != nil {
		return common.HexToHash(s)
	}
	return h
}

