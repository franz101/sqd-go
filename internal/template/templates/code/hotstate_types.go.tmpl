{{define "hotStateBatchResolver" -}}
{{- /*
  hotStateBatchResolver renders <T>BatchResolver: it collects lazy-Get misses and
  resolves them in one batched ClickHouse round-trip (vs one SELECT per key).

  Data (see renderBatchResolver):
    .ResolverType .CacheType .KeyType .ValueType - the four type names
    .KeyValuesAppendExpr - expr appended per key to build the IN (...) list
    .QueryStmt           - the precomputed `queryStr := fmt.Sprintf(...)` line
                           (empty .KeyFields => no key columns => queryStr := "")
    .Fields[]            - per-column result plumbing; .IsMeta marks the
                           EventMeta-embedded columns (events only)
    .KeyFields[]         - key columns, for the not-found tombstone write-back
    .IsEvent             - splits item construction into EventMeta{...} + fields
*/ -}}
type {{.ResolverType}} struct {
	cache  *{{.CacheType}}
	// mu protects only misses. Cross-block resolve pipelining (State.StartPrune's
	// sibling for resolve — see State.StartResolvePending) can call Queue and
	// Resolve on the same resolver from two goroutines at once: real-apply's
	// lazy fallback path (state.go's GetValue) for the in-flight block racing
	// the next block's prefetch dry-run dispatch. Resolve detaches misses into a
	// local batch under the lock and does all the dedup/query work — including
	// the network round trip — outside it, so pipelined resolves never
	// serialize on each other; only the brief append/detach does. Metrics stay
	// single-owner/unprotected: EnableMetrics is test/diagnostic-only and never
	// combined with pipelining in this codebase.
	mu     sync.Mutex
	misses []{{.KeyType}}
	metricsEnabled bool
	metrics BatchResolverMetrics
	hot *HotState
}

func New{{.ResolverType}}(cache *{{.CacheType}}) *{{.ResolverType}} {
	return &{{.ResolverType}}{
		cache: cache,
	}
}

func (r *{{.ResolverType}}) Lookup(key {{.KeyType}}) ({{.ValueType}}, bool) {
	return r.cache.Get(key)
}

func (c *{{.CacheType}}) coldMightContainKey(key {{.KeyType}}) bool {
	if c == nil || c.cold == nil {
		return true
	}
	k := key
	return c.cold.MightContain(unsafe.Slice((*byte)(unsafe.Pointer(&k)), unsafe.Sizeof(k)))
}

func (r *{{.ResolverType}}) Queue(key {{.KeyType}}) {
	// Provably-new fast path: under an authoritative cold tier a key the
	// negative filter has never seen cannot exist in ClickHouse, so the lazy Get
	// returns zero and queuing it for a resolve would be a wasted CH round-trip.
	if r.hot != nil && r.hot.coldAuthoritative && !r.cache.coldMightContainKey(key) {
		if r.metricsEnabled {
			r.metrics.Skipped++
		}
		return
	}
	if _, ok := r.Lookup(key); !ok {
		if r.metricsEnabled {
			r.metrics.QueuedMisses++
		}
		r.mu.Lock()
		r.misses = append(r.misses, key)
		r.mu.Unlock()
	}
}

// Pending reports how many missed keys are queued for the next Resolve.
func (r *{{.ResolverType}}) Pending() int {
	r.mu.Lock()
	defer r.mu.Unlock()
	return len(r.misses)
}

