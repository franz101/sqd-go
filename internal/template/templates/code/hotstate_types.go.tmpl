// snapshotDirty builds the insert batches from the dirty sets + hot ring and clears
// the dirty sets, under s.mu and with NO network I/O. It MUST be called from the
// single processor (consumer) goroutine: Get may promote a cold entry into the ring
// (a ring mutation), which is only safe when no other goroutine touches the ring. The
// returned batches hold value copies only, so the subsequent Insert is ring-free.
func (s *HotState) snapshotDirty() *commitBatches {
	s.mu.Lock()
	defer s.mu.Unlock()
	cb := &commitBatches{}
{{- range .Specs}}{{if not .IsEvent}}
	if len(s.dirty{{.BaseName}}) > 0 {
		cb.{{.BaseName}} = New{{.BatchType}}()
		for key := range s.dirty{{.BaseName}} {
			if val, ok := s.{{.BaseName}}.Get(key); ok {
				cb.{{.BaseName}}.Append(val)
			}
		}
		clear(s.dirty{{.BaseName}})
	}
{{- end}}{{end}}
	return cb
}

// insert writes the snapshotted batches to ClickHouse. It touches NO hot-ring state,
// so it is safe to run in a background goroutine concurrently with the fold.
func (cb *commitBatches) insert(ctx context.Context, conn *ch.Client, db string) error {
{{- range .Specs}}{{if not .IsEvent}}
	if cb.{{.BaseName}} != nil {
		if err := cb.{{.BaseName}}.Insert(ctx, conn, db); err != nil {
			return err
		}
	}
{{- end}}{{end}}
	if err := flushAsyncInserts(ctx, conn); err != nil {
		return err
	}
	return nil
}

// Commit synchronously snapshots the dirty sets and inserts them. The async path is
// State.StartCommit, which snapshots in the consumer thread and runs only insert() in
// a goroutine, so the network insert never holds s.mu or touches the ring.
func (s *HotState) Commit(ctx context.Context, conn *ch.Client, db string) error {
	if conn == nil {
		s.mu.Lock()
{{- range .Specs}}{{if not .IsEvent}}
		clear(s.dirty{{.BaseName}})
{{- end}}{{end}}
		s.mu.Unlock()
		return nil
	}
	return s.snapshotDirty().insert(ctx, conn, db)
}
