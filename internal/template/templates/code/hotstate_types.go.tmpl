		{Name: {{.ColumnNameQuoted}}, Data: {{.ResultData}}},
{{- end}}
	}
	foundKeys := make(map[{{.KeyType}}]struct{}, len(uniqueList))
	q := ch.Query{
		Body:   queryStr,
		Result: results,
		OnResult: func(ctx context.Context, block proto.Block) error {
			for i := 0; i < block.Rows; i++ {
				item := {{.ValueType}}{
{{- if .IsEvent}}
					EventMeta: EventMeta{
{{- range .Fields}}{{if .IsMeta}}
						{{.Name}}: {{.ValueExpr}},
{{- end}}{{end}}
					},
{{- range .Fields}}{{if not .IsMeta}}
					{{.Name}}: {{.ValueExpr}},
{{- end}}{{end}}
{{- else}}
{{- range .Fields}}
					{{.Name}}: {{.ValueExpr}},
{{- end}}
{{- end}}
				}
				r.cache.Set(item)
				foundKeys[New{{.KeyType}}(item)] = struct{}{}
			}
			return nil
		},
	}
	var resolveStart time.Time
	if r.metricsEnabled {
		r.metrics.RoundTrips++
		resolveStart = time.Now()
	}
	err := conn.Do(ctx, q)
	if r.metricsEnabled {
		r.metrics.ResolveNanos += uint64(time.Since(resolveStart))
	}
	if err != nil {
		return err
	}
	for _, key := range uniqueList {
		if _, found := foundKeys[key]; !found {
			tombstone := {{.ValueType}}{Tombstone: true}
{{- range .KeyFields}}
			tombstone.{{.Name}} = key.{{.Name}}
{{- end}}
			r.cache.SetByKey(key, tombstone)
		}
	}
	return nil
}

{{end}}
