{{define "hotStateType"}}type HotState struct {
{{- range .Specs}}
	{{.BaseName}} *{{.CacheType}}
	{{.BaseName}}Resolver *{{.ResolverType}}
{{- if not .IsEvent}}
	dirty{{.BaseName}} map[{{.KeyType}}]struct{}
{{- end}}
{{- end}}
	mu sync.Mutex
	// coldAuthoritative is set when the cold tier was opened against an empty
	// ClickHouse (from-genesis backfill): a hot+cold miss is then provably new,
	// so the lazy state Get skips the ClickHouse point-SELECT entirely.
	coldAuthoritative bool
	// prefetchEnabled turns on the two-pass batch prefetch (--prefetch): each
	// block is dispatched once in recordMode to collect the read-set, resolved in
	// one round-trip per entity, then dispatched again for real against a warm cache.
	prefetchEnabled bool
	// recordMode is set for the duration of a prefetch dry-run pass. While set,
	// the lazy state Get queues misses instead of resolving them synchronously,
	// and Save is suppressed (the dry run has no committed side effects).
	recordMode bool
	// Async resolve state: non-blocking resolution of entity resolver misses.
	// When enabled, resolver queries run in background goroutines via
	// StartResolveAllPending, allowing other work to overlap.
	resolveAsyncEnabled bool
	resolveInProgress   bool
	resolveDone         chan resolveResult
	resolveConns        []*ch.Client
	resolveDB           string
	resolveCtx          context.Context
	resolveCancel       context.CancelFunc
}

