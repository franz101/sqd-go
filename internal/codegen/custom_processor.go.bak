package codegen

import (
	"bytes"
	"go/format"
	"strconv"

	"github.com/franz101/sqd-go/internal/config"
)

func generateCustomProcessorGo(events []eventSpec) ([]byte, error) {
	var b bytes.Buffer
	b.WriteString(`// Code generated by sqd-go codegen; DO NOT EDIT.

package generated

import (
	"context"
	"fmt"
	"math/big"
	"sync"

	"github.com/ClickHouse/ch-go"
	"github.com/ClickHouse/ch-go/proto"
	"github.com/ethereum/go-ethereum/common"
	"github.com/holiman/uint256"
)

type AddressPosition struct {
	Address        common.Address
	Balance        big.Int
	TotalIn        uint256.Int
	TotalOut       uint256.Int
	NetFlow        big.Int
	RealizedPnL    big.Int
	TransferCount  uint64
	UpdatedAtBlock uint64
}

type MemoryState struct {
	AddressPositions map[common.Address]*AddressPosition
	mu               sync.RWMutex
	LastSyncBlock    uint64
}

func NewMemoryState() *MemoryState {
	return &MemoryState{AddressPositions: make(map[common.Address]*AddressPosition)}
}

var GlobalState = NewMemoryState()

func CustomProcessing(ctx context.Context, store Store, entities *Entities) error {
	if entities == nil {
		return nil
	}
	s := GlobalState
`)
	for _, ev := range events {
		if !isERC20Transfer(ev) {
			continue
		}
		fromField := ev.Args[0].GoFieldName
		toField := ev.Args[1].GoFieldName
		valueField := ev.Args[2].GoFieldName
		b.WriteString("\tfor _, ev := range entities.")
		b.WriteString(ev.GoTypeName)
		b.WriteString(" {\n")
		b.WriteString("\t\ts.ApplyTransfer(ev.")
		b.WriteString(fromField)
		b.WriteString(", ev.")
		b.WriteString(toField)
		b.WriteString(", &ev.")
		b.WriteString(valueField)
		b.WriteString(", ev.BlockNumber)\n\t}\n")
	}
	b.WriteString(`	if entities.BlockNumber > 0 {
		if err := s.SyncToClickHouse(ctx, store, entities.BlockNumber); err != nil {
			return err
		}
		s.LastSyncBlock = entities.BlockNumber
	}
	return nil
}

func (s *MemoryState) ApplyTransfer(from, to common.Address, value *uint256.Int, blockNumber uint64) {
	if value == nil {
		return
	}
	zero := common.Address{}
	amount := value.ToBig()
	s.mu.Lock()
	defer s.mu.Unlock()
	if from != zero {
		pos := s.positionLocked(from)
		pos.Balance.Sub(&pos.Balance, amount)
		pos.NetFlow.Set(&pos.Balance)
		pos.TotalOut.Add(&pos.TotalOut, value)
		pos.TransferCount++
		pos.UpdatedAtBlock = blockNumber
	}
	if to != zero {
		pos := s.positionLocked(to)
		pos.Balance.Add(&pos.Balance, amount)
		pos.NetFlow.Set(&pos.Balance)
		pos.TotalIn.Add(&pos.TotalIn, value)
		pos.TransferCount++
		pos.UpdatedAtBlock = blockNumber
	}
}

func (s *MemoryState) Position(address common.Address) (AddressPosition, bool) {
	s.mu.RLock()
	defer s.mu.RUnlock()
	pos, ok := s.AddressPositions[address]
	if !ok {
		return AddressPosition{Address: address}, false
	}
	return copyPosition(pos), true
}

func (s *MemoryState) positionLocked(address common.Address) *AddressPosition {
	pos := s.AddressPositions[address]
	if pos == nil {
		pos = &AddressPosition{Address: address}
		s.AddressPositions[address] = pos
	}
	return pos
}

func copyPosition(pos *AddressPosition) AddressPosition {
	out := AddressPosition{
		Address:        pos.Address,
		TransferCount:  pos.TransferCount,
		UpdatedAtBlock: pos.UpdatedAtBlock,
	}
	out.Balance.Set(&pos.Balance)
	out.TotalIn.Set(&pos.TotalIn)
	out.TotalOut.Set(&pos.TotalOut)
	out.NetFlow.Set(&pos.NetFlow)
	out.RealizedPnL.Set(&pos.RealizedPnL)
	return out
}

func (s *MemoryState) SyncToClickHouse(ctx context.Context, store Store, blockNumber uint64) error {
	if store == nil || store.Conn() == nil || len(s.AddressPositions) == 0 {
		return nil
	}
	s.mu.RLock()
	positions := make([]AddressPosition, 0, len(s.AddressPositions))
	for _, pos := range s.AddressPositions {
		positions = append(positions, copyPosition(pos))
	}
	s.mu.RUnlock()

	var (
		colAddress        proto.ColFixedStr
		colBalance        proto.ColStr
		colTotalIn        proto.ColStr
		colTotalOut       proto.ColStr
		colNetFlow        proto.ColStr
		colRealizedPnL    proto.ColStr
		colTransferCount  proto.ColUInt64
		colUpdatedAtBlock proto.ColUInt64
	)
	colAddress.SetSize(20)
	for _, pos := range positions {
		colAddress.Append(pos.Address.Bytes())
		colBalance.Append(pos.Balance.String())
		colTotalIn.Append(pos.TotalIn.Dec())
		colTotalOut.Append(pos.TotalOut.Dec())
		colNetFlow.Append(pos.NetFlow.String())
		colRealizedPnL.Append(pos.RealizedPnL.String())
		colTransferCount.Append(pos.TransferCount)
		colUpdatedAtBlock.Append(blockNumber)
	}
	return store.Conn().Do(ctx, ch.Query{
		Body: fmt.Sprintf("INSERT INTO %s.erc20_address_positions (address, balance_raw, total_in_raw, total_out_raw, net_flow_raw, realized_pnl_raw, transfer_count, updated_at_block) VALUES", quoteIdent(store.DB())),
		Input: []proto.InputColumn{
			{Name: "address", Data: &colAddress},
			{Name: "balance_raw", Data: &colBalance},
			{Name: "total_in_raw", Data: &colTotalIn},
			{Name: "total_out_raw", Data: &colTotalOut},
			{Name: "net_flow_raw", Data: &colNetFlow},
			{Name: "realized_pnl_raw", Data: &colRealizedPnL},
			{Name: "transfer_count", Data: &colTransferCount},
			{Name: "updated_at_block", Data: &colUpdatedAtBlock},
		},
	})
}

func PositionSummary(address common.Address) string {
	pos, ok := GlobalState.Position(address)
	if !ok {
		return fmt.Sprintf("%s position not found", address.Hex())
	}
	return fmt.Sprintf("%s balance=%s total_in=%s total_out=%s net_flow=%s realized_pnl=%s transfers=%d updated_at_block=%d",
		address.Hex(),
		pos.Balance.String(),
		pos.TotalIn.Dec(),
		pos.TotalOut.Dec(),
		pos.NetFlow.String(),
		pos.RealizedPnL.String(),
		pos.TransferCount,
		pos.UpdatedAtBlock,
	)
}

func _customProcessorEventCount() int {
	return `)
	b.WriteString(strconv.Itoa(len(events)))
	b.WriteString(`
}
`)
	return format.Source(b.Bytes())
}

func generateEmptyCustomProcessorGo(cfg *config.Config, events []eventSpec, hotStateTables []customTableSpec) ([]byte, error) {
	var b bytes.Buffer
	b.WriteString(`// Code generated by sqd-go codegen; DO NOT EDIT.

package generated

`)

	if len(hotStateTables) == 0 {
		b.WriteString(`import (
	"context"
)

// CustomProcessing is called during block processing to run custom business logic.
// You have access to the db store, and the entities containing decoded event logs.
func CustomProcessing(ctx context.Context, store Store, entities *Entities) error {
	if entities == nil {
		return nil
	}
	return nil
}
`)
		return format.Source(b.Bytes())
	}

	b.WriteString(`import (
	"context"
	"fmt"
	"log"
	"os"
	"strconv"

	"github.com/ethereum/go-ethereum/common"
	"github.com/franz101/sqd-go/internal/database"
	"github.com/franz101/sqd-go/internal/ingestion"
)

// CustomProcessFn is the callback registered by the custom processor.
var CustomProcessFn func(state *State, slot *BlockEventsSlot) error

// CustomProcessing wraps the slot-based processing
func CustomProcessing(ctx context.Context, store Store, state *State, slot *BlockEventsSlot) error {
	if state == nil || slot == nil {
		return nil
	}
	state.Store = store
	// Prefetch state
	if err := prefetchSlotState(ctx, store, state, slot); err != nil {
		return fmt.Errorf("custom state prefetch failed: %w", err)
	}

	// Process slot
	if CustomProcessFn != nil {
		if err := CustomProcessFn(state, slot); err != nil {
			return err
		}
	}

	// Commit state & prune
	if slot.BlockNumber >= state.LastSyncBlock+1000 {
		state.SaveSnapshot(slot.BlockNumber)
		if err := state.Commit(ctx, store); err != nil {
			return err
		}

		pruneInterval := uint64(100000)
		if envVal := os.Getenv("CLICKHOUSE_PRUNE_INTERVAL"); envVal != "" {
			if parsed, err := strconv.ParseUint(envVal, 10, 64); err == nil {
				pruneInterval = parsed
			}
		}
		if slot.BlockNumber >= state.LastPruneBlock+pruneInterval {
			if err := CompactionPruneState(ctx, store, slot.BlockNumber); err != nil {
				log.Printf("[PRUNING WARNING] Failed to prune Clickhouse tables: %v", err)
			}
			state.LastPruneBlock = slot.BlockNumber
		}

		state.LastSyncBlock = slot.BlockNumber
	}

	return nil
}

const defaultRingBufferSize uint32 = 1024
const prefetchSlotBatchSize = 8

type Processor struct {
	ring  *OrderedHistoricRingBuffer
	State *State
}

func NewProcessor() (*Processor, error) {
	ring, err := NewOrderedHistoricRingBuffer(defaultRingBufferSize)
	if err != nil {
		return nil, err
	}
	return &Processor{
		ring:  ring,
		State: NewState(),
	}, nil
}

func (p *Processor) Process(ctx context.Context, store *database.Store, logs []ingestion.CustomLog) error {
	if p == nil || len(logs) == 0 {
		return nil
	}
	if p.ring == nil {
		ring, err := NewOrderedHistoricRingBuffer(defaultRingBufferSize)
		if err != nil {
			return err
		}
		p.ring = ring
	}
	if p.State == nil {
		p.State = NewState()
	}
	p.State.Store = store

	type blockGroup struct {
		blockNum  uint64
		blockHash string
		logs      []DecodedLog
	}

	var groups []blockGroup
	var curGroup *blockGroup
	for _, lg := range logs {
		meta := EventMeta{
			BlockNumber:      lg.BlockNumber,
			BlockTimestamp:   lg.BlockTimestamp,
			BlockHash:        common.HexToHash(lg.BlockHash),
			ContractAddress:  common.HexToAddress(lg.ContractAddress),
			TransactionHash:  common.HexToHash(lg.TransactionHash),
			TransactionIndex: lg.TransactionIndex,
			LogIndex:         lg.LogIndex,
		}
		decoded, err := UnpackLogWithMeta(lg.ContractAddress, lg.Topics, common.FromHex(lg.Data), meta)
		if err != nil {
			return fmt.Errorf("unpack log block=%d tx=%s log=%d: %w", lg.BlockNumber, lg.TransactionHash, lg.LogIndex, err)
		}
		if decoded == nil || decoded.Value == nil {
			continue
		}

		if curGroup == nil || curGroup.blockNum != lg.BlockNumber {
			groups = append(groups, blockGroup{blockNum: lg.BlockNumber, blockHash: lg.BlockHash})
			curGroup = &groups[len(groups)-1]
		}
		curGroup.logs = append(curGroup.logs, *decoded)
	}

	slots := make([]*BlockEventsSlot, 0, len(groups))
	for _, group := range groups {
		p.ring.Push(group.blockNum, group.blockHash, group.logs)
		slot, ok := p.ring.GetBlockEvents(group.blockNum)
		if !ok {
			return fmt.Errorf("slot for block %d not found after push", group.blockNum)
		}
		slots = append(slots, slot)
	}

	for start := 0; start < len(slots); start += prefetchSlotBatchSize {
		end := start + prefetchSlotBatchSize
		if end > len(slots) {
			end = len(slots)
		}
		chunk := slots[start:end]
		if err := prefetchSlotsState(ctx, store, p.State, chunk); err != nil {
			return fmt.Errorf("custom state prefetch failed: %w", err)
		}
		for _, slot := range chunk {
			if err := CustomProcessing(ctx, store, p.State, slot); err != nil {
				return fmt.Errorf("custom processing block %d failed: %w", slot.BlockNumber, err)
			}
			PrintPnLSummary(p.State, slot.BlockNumber)
		}
	}

	return nil
}

func (p *Processor) RestoreToBlock(blockNumber uint64) error {
	if p == nil || p.State == nil {
		return nil
	}
	return p.State.RestoreToBlock(blockNumber)
}

func (p *Processor) LoadFromDatabase(blockNumber uint64) error {
	if p == nil {
		return nil
	}
	if p.State == nil {
		p.State = NewState()
	}

	httpPort := 8123
	if portStr := os.Getenv("CLICKHOUSE_HTTP_PORT"); portStr != "" {
		if pVal, err := strconv.Atoi(portStr); err == nil {
			httpPort = pVal
		}
	}

	if err := p.State.LoadFromClickHouse(context.Background(), httpPort, blockNumber); err != nil {
		return fmt.Errorf("failed to load state from ClickHouse: %w", err)
	}

	p.State.LastSyncBlock = blockNumber
	p.State.SaveSnapshot(blockNumber)
	return nil
}

func prefetchSlotState(ctx context.Context, store Store, state *State, slot *BlockEventsSlot) error {
	return prefetchSlotsState(ctx, store, state, []*BlockEventsSlot{slot})
}

`)

	renderGenericPrefetchSlotsState(&b, cfg, events, hotStateTables)
	b.WriteString(`func PrintPnLSummary(state *State, blockNumber uint64) {}
`)

	return format.Source(b.Bytes())
}

type statePrefetchPlan struct {
	stateName string
	baseName  string
	keyType   string
	keyFields []customFieldSpec
	sources   []statePrefetchSource
}

type statePrefetchSource struct {
	slotField string
	eventType string
	fields    []statePrefetchField
}

type statePrefetchField struct {
	keyField   string
	eventField string
}

func renderGenericPrefetchSlotsState(b *bytes.Buffer, cfg *config.Config, events []eventSpec, hotStateTables []customTableSpec) {
	plans := buildStatePrefetchPlans(cfg, events, hotStateSpecs(hotStateTables))
	if len(plans) == 0 {
		b.WriteString(`func prefetchSlotsState(ctx context.Context, store Store, state *State, slots []*BlockEventsSlot) error {
	return nil
}
`)
		return
	}

	b.WriteString(`func prefetchSlotsState(ctx context.Context, store Store, state *State, slots []*BlockEventsSlot) error {
	if state == nil || state.HotState == nil || store == nil || store.Conn() == nil || len(slots) == 0 {
		return nil
	}
	hot := state.HotState

	for _, slot := range slots {
		if slot == nil {
			continue
		}
		// Custom prefetch for Position on OrderFilled events
		for _, ev := range slot.ExchangeOrderFilleds {
			var tokenID common.Hash
			if ev.MakerAssetID.IsZero() {
				ev.TakerAssetID.WriteToSlice(tokenID[:])
			} else {
				ev.MakerAssetID.WriteToSlice(tokenID[:])
			}
			hot.UserPositionsResolver.Queue(UserPositionsClockKey{User: ev.Maker, TokenID: tokenID})
		}
		for _, ev := range slot.NegRiskExchangeOrderFilleds {
			var tokenID common.Hash
			if ev.MakerAssetID.IsZero() {
				ev.TakerAssetID.WriteToSlice(tokenID[:])
			} else {
				ev.MakerAssetID.WriteToSlice(tokenID[:])
			}
			hot.UserPositionsResolver.Queue(UserPositionsClockKey{User: ev.Maker, TokenID: tokenID})
		}
`)
	for _, plan := range plans {
		for _, source := range plan.sources {
			b.WriteString("\t\tfor _, ev := range slot.")
			b.WriteString(source.slotField)
			b.WriteString(" {\n")
			b.WriteString("\t\t\thot.")
			b.WriteString(plan.baseName)
			b.WriteString("Resolver.Queue(")
			b.WriteString(plan.keyType)
			b.WriteString("{")
			for i, field := range source.fields {
				if i > 0 {
					b.WriteString(", ")
				}
				b.WriteString(field.keyField)
				b.WriteString(": ev.")
				b.WriteString(field.eventField)
			}
			b.WriteString("})\n\t\t}\n")
		}
	}
	b.WriteString("\t}\n\n")
	
	// Resolve custom prefetch for Position
	b.WriteString("\tif err := hot.UserPositionsResolver.Resolve(ctx, store.Conn(), store.DB()); err != nil {\n")
	b.WriteString("\t\treturn fmt.Errorf(\"prefetch Position: %w\", err)\n\t}\n")

	for _, plan := range plans {
		b.WriteString("\tif err := hot.")
		b.WriteString(plan.baseName)
		b.WriteString("Resolver.Resolve(ctx, store.Conn(), store.DB()); err != nil {\n")
		b.WriteString("\t\treturn fmt.Errorf(")
		b.WriteString(strconv.Quote("prefetch " + plan.stateName + ": %w"))
		b.WriteString(", err)\n\t}\n")
	}
	b.WriteString("\treturn nil\n}\n")
}

func buildStatePrefetchPlans(cfg *config.Config, events []eventSpec, specs []hotStateSpec) []statePrefetchPlan {
	if cfg == nil || len(cfg.State) == 0 {
		return nil
	}
	var plans []statePrefetchPlan
	for _, state := range cfg.State {
		spec, ok := statePrefetchSpec(state, events, specs)
		if !ok {
			continue
		}
		keyFields := spec.table.keyFields()
		if len(keyFields) == 0 {
			continue
		}
		plan := statePrefetchPlan{
			stateName: state.Name,
			baseName:  spec.baseName,
			keyType:   spec.keyType,
			keyFields: keyFields,
		}
		for _, source := range events {
			fields, ok := statePrefetchFields(source, keyFields)
			if !ok {
				continue
			}
			plan.sources = append(plan.sources, statePrefetchSource{
				slotField: source.GoTypeName + "s",
				eventType: source.GoTypeName,
				fields:    fields,
			})
		}
		if len(plan.sources) > 0 {
			plans = append(plans, plan)
		}
	}
	return plans
}

func statePrefetchSpec(state config.StateConfig, events []eventSpec, specs []hotStateSpec) (hotStateSpec, bool) {
	if table, ok := findStateCustomTableSpec(hotStateTables(specs), state); ok {
		return findHotStateSpec(specs, table)
	}
	target, err := findStateEventSpec(events, state)
	if err != nil {
		return hotStateSpec{}, false
	}
	table := stateEventToCustomTableSpec(target, state)
	return findHotStateSpec(specs, table)
}

func statePrefetchFields(source eventSpec, keyFields []customFieldSpec) ([]statePrefetchField, bool) {
	fields := make([]statePrefetchField, 0, len(keyFields))
	for _, keyField := range keyFields {
		arg, ok := matchingStatePrefetchArg(source, keyField)
		if !ok {
			return nil, false
		}
		fields = append(fields, statePrefetchField{keyField: keyField.Name, eventField: arg.GoFieldName})
	}
	return fields, true
}

func matchingStatePrefetchArg(source eventSpec, keyField customFieldSpec) (eventArg, bool) {
	for _, arg := range source.Args {
		if arg.ColumnName == keyField.ColumnName || arg.Name == keyField.ColumnName || arg.GoFieldName == keyField.Name {
			return arg, true
		}
	}
	return eventArg{}, false
}
