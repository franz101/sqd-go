<!-- Cap ClickHouse self-telemetry. Without this the system database grew to
     35 GiB (text_log alone 19 GiB) on a long-running indexer box. The chatty
     debug logs are disabled outright; query_log/part_log stay for diagnostics
     but expire after 3 days. Mounted via compose so it survives recreation. -->
<clickhouse>
    <text_log remove="remove"/>
    <trace_log remove="remove"/>
    <processors_profile_log remove="remove"/>
    <metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <query_thread_log remove="remove"/>
    <query_metric_log remove="remove"/>
    <latency_log remove="remove"/>
    <query_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </part_log>
</clickhouse>
